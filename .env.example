# Copia este archivo como .env y añade una clave API del proveedor que usarás.
# Nunca subas .env ni claves reales a GitHub.
PORT=4173
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=none

# Opcional: comando o ruta al ejecutable Codex CLI. Por defecto: codex
CODEX_EXECUTABLE=codex
# Opcional: directorio de trabajo para Codex (debe ser una carpeta existente).
# Por defecto, se utiliza la carpeta del repositorio de Norteño Studio AI.
CODEX_WORKDIR=
